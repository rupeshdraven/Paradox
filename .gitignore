# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env
*.env.local
*.env.production
.streamlit/secrets.toml

# Dependencies
node_modules/
*/node_modules/
package-lock.json.backup

# Python Bytecode & Cache
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/
.Python
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Build & Bundler Outputs
dist/
frontend/dist/
dist-ssr/
build/
frontend/.tmp/
.tsbuildinfo
node_modules/.tmp/

# SQLite & Local Databases
*.db
*.sqlite
*.sqlite3
backend/finwise.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
